// ==============================================================================
// FINN AI — Prisma Schema Specification
// Database: PostgreSQL 16
// Monetary precision: Decimal(14, 2) / Decimal(18, 4)
// ==============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum UserRole {
  ADMIN
  MEMBER
}

enum HouseholdRole {
  OWNER
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum AccountType {
  CHECKING
  SAVINGS
  INVESTMENT
  CASH
  DIGITAL_WALLET
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionStatus {
  PENDING
  POSTED
  CANCELLED
}

enum SyncStatus {
  IDLE
  RUNNING
  SUCCESS
  FAILED
  CONSENT_EXPIRED
}

enum BillStatus {
  OPEN
  CLOSED
  PAID
  OVERDUE
}

enum GoalStatus {
  IN_PROGRESS
  COMPLETED
  PAUSED
  CANCELLED
}

enum DocumentType {
  OFX
  CSV
  PDF_STATEMENT
  RECEIPT_IMAGE
  AUDIO
  OTHER
}

enum SharingAccessLevel {
  NONE
  VIEW_ONLY
  VIEW_AND_EDIT
}

// ------------------------------------------------------------------------------
// 1. USUÁRIOS, SESSÕES E GOVERNANÇA FAMILIAR
// ------------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String    @map("password_hash")
  fullName        String    @map("full_name")
  phone           String?
  avatarUrl       String?   @map("avatar_url")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions              Session[]
  householdMemberships  HouseholdMember[]
  sentInvitations       HouseholdInvitation[] @relation("SentInvitations")
  accounts              FinancialAccount[]
  creditCards           CreditCard[]
  bankConnections       BankConnection[]
  transactions          Transaction[]
  aiConversations       AiConversation[]
  aiPreferences         AiPreference[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  userConsents          UserConsent[]
  appSettings           AppSetting[]
  sharedPermissionsFrom SharingPermission[]   @relation("OwnerPermissions")
  sharedPermissionsTo   SharingPermission[]   @relation("RecipientPermissions")
  documents             Document[]
  importBatches         ImportBatch[]

  @@map("users")
}

model Session {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Household {
  id          String   @id @default(uuid())
  name        String
  currency    String   @default("BRL")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members           HouseholdMember[]
  invitations       HouseholdInvitation[]
  budgets           Budget[]
  goals             Goal[]
  financialPlans    FinancialPlan[]
  categories        TransactionCategory[]

  @@map("households")
}

model HouseholdMember {
  id          String        @id @default(uuid())
  householdId String        @map("household_id")
  userId      String        @map("user_id")
  role        HouseholdRole @default(MEMBER)
  joinedAt    DateTime      @default(now()) @map("joined_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@map("household_members")
}

model HouseholdInvitation {
  id          String           @id @default(uuid())
  householdId String           @map("household_id")
  invitedById String           @map("invited_by_id")
  email       String
  role        HouseholdRole    @default(MEMBER)
  tokenHash   String           @unique @map("token_hash")
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at")
  acceptedAt  DateTime?        @map("accepted_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@map("household_invitations")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("permissions")
}

model SharingPermission {
  id              String             @id @default(uuid())
  ownerUserId     String             @map("owner_user_id")
  recipientUserId String             @map("recipient_user_id")
  resourceType    String             @map("resource_type") // 'ACCOUNT', 'CREDIT_CARD', 'GOAL'
  resourceId      String             @map("resource_id")
  accessLevel     SharingAccessLevel @default(VIEW_ONLY) @map("access_level")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  owner     User @relation("OwnerPermissions", fields: [ownerUserId], references: [id], onDelete: Cascade)
  recipient User @relation("RecipientPermissions", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, recipientUserId, resourceType, resourceId])
  @@map("sharing_permissions")
}

// ------------------------------------------------------------------------------
// 2. CONEXÕES BANCÁRIAS E OPEN FINANCE (MEU PLUGGY)
// ------------------------------------------------------------------------------

model BankConnection {
  id               String     @id @default(uuid())
  userId           String     @map("user_id")
  provider         String     @default("PLUGGY") // 'PLUGGY', 'MANUAL', 'OFX'
  institutionName  String     @map("institution_name")
  institutionCode  String?    @map("institution_code")
  connectorId      String?    @map("connector_id")
  status           SyncStatus @default(IDLE)
  consentExpiresAt DateTime?  @map("consent_expires_at")
  lastSyncAt       DateTime?  @map("last_sync_at")
  errorMessage     String?    @map("error_message")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  items    BankConnectionItem[]
  syncJobs BankSyncJob[]
  history  BankSyncHistory[]
  accounts FinancialAccount[]

  @@map("bank_connections")
}

model BankConnectionItem {
  id               String   @id @default(uuid())
  bankConnectionId String   @map("bank_connection_id")
  externalItemId   String   @map("external_item_id") // itemId do Pluggy
  status           String   @default("UPDATED")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  connection BankConnection @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)

  @@unique([bankConnectionId, externalItemId])
  @@map("bank_connection_items")
}

model BankSyncJob {
  id               String     @id @default(uuid())
  bankConnectionId String     @map("bank_connection_id")
  status           SyncStatus @default(RUNNING)
  attempts         Int        @default(0)
  startedAt        DateTime   @default(now()) @map("started_at")
  finishedAt       DateTime?  @map("finished_at")
  error            String?

  connection BankConnection @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)

  @@map("bank_sync_jobs")
}

model BankSyncHistory {
  id                 String     @id @default(uuid())
  bankConnectionId   String     @map("bank_connection_id")
  status             SyncStatus
  accountsSynced     Int        @default(0) @map("accounts_synced")
  transactionsSynced Int        @default(0) @map("transactions_synced")
  durationMs         Int        @map("duration_ms")
  message            String?
  createdAt          DateTime   @default(now()) @map("created_at")

  connection BankConnection @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)

  @@map("bank_sync_history")
}

// ------------------------------------------------------------------------------
// 3. CONTAS FINANCEIRAS, CARTÕES E FATURAS
// ------------------------------------------------------------------------------

model FinancialAccount {
  id               String      @id @default(uuid())
  userId           String      @map("user_id")
  bankConnectionId String?     @map("bank_connection_id")
  name             String
  type             AccountType @default(CHECKING)
  currency         String      @default("BRL")
  currentBalance   Decimal     @default(0.00) @map("current_balance") @db.Decimal(14, 2)
  calculatedBalance Decimal    @default(0.00) @map("calculated_balance") @db.Decimal(14, 2)
  accountNumber    String?     @map("account_number")
  isShared         Boolean     @default(false) @map("is_shared")
  colorHex         String?     @map("color_hex")
  icon             String?
  isActive         Boolean     @default(true) @map("is_active")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankConnection BankConnection? @relation(fields: [bankConnectionId], references: [id], onDelete: SetNull)
  transactions   Transaction[]
  creditCards    CreditCard[]

  @@map("financial_accounts")
}

model CreditCard {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  financialAccountId String?  @map("financial_account_id")
  name               String
  brand              String?  // VISA, MASTERCARD, etc.
  creditLimit        Decimal  @map("credit_limit") @db.Decimal(14, 2)
  closingDay         Int      @map("closing_day")
  dueDay             Int      @map("due_day")
  colorHex           String?  @map("color_hex")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedAccount    FinancialAccount? @relation(fields: [financialAccountId], references: [id], onDelete: SetNull)
  bills            CreditCardBill[]
  transactions     Transaction[]

  @@map("credit_cards")
}

model CreditCardBill {
  id           String     @id @default(uuid())
  creditCardId String     @map("credit_card_id")
  month        Int
  year         Int
  closingDate  DateTime   @map("closing_date")
  dueDate      DateTime   @map("due_date")
  totalAmount  Decimal    @default(0.00) @map("total_amount") @db.Decimal(14, 2)
  paidAmount   Decimal    @default(0.00) @map("paid_amount") @db.Decimal(14, 2)
  status       BillStatus @default(OPEN)
  paidAt       DateTime?  @map("paid_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  creditCard   CreditCard    @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([creditCardId, month, year])
  @@map("credit_card_bills")
}

// ------------------------------------------------------------------------------
// 4. TRANSAÇÕES, CATEGORIAS, RECORRÊNCIAS E PARCELAS
// ------------------------------------------------------------------------------

model TransactionCategory {
  id          String   @id @default(uuid())
  householdId String?  @map("household_id")
  name        String
  icon        String?
  colorHex    String?  @map("color_hex")
  parentId    String?  @map("parent_id")
  createdAt   DateTime @default(now()) @map("created_at")

  household    Household?            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  parent       TransactionCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     TransactionCategory[] @relation("CategoryHierarchy")
  transactions Transaction[]
  budgets      Budget[]

  @@map("transaction_categories")
}

model Transaction {
  id                 String            @id @default(uuid())
  userId             String            @map("user_id")
  accountId          String?           @map("account_id")
  creditCardId       String?           @map("credit_card_id")
  creditCardBillId   String?           @map("credit_card_bill_id")
  categoryId         String?           @map("category_id")
  installmentId      String?           @map("installment_id")
  recurringId        String?           @map("recurring_id")
  documentId         String?           @map("document_id")
  type               TransactionType
  status             TransactionStatus @default(POSTED)
  amount             Decimal           @db.Decimal(14, 2)
  date               DateTime
  competenceDate     DateTime?         @map("competence_date")
  description        String
  notes              String?
  merchantName       String?           @map("merchant_name")
  isHouseholdShared  Boolean           @default(false) @map("is_household_shared")
  idempotencyKey     String?           @unique @map("idempotency_key")
  externalId         String?           @map("external_id")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account            FinancialAccount?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  creditCard         CreditCard?           @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  creditCardBill     CreditCardBill?       @relation(fields: [creditCardBillId], references: [id], onDelete: SetNull)
  category           TransactionCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  installment        Installment?          @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  recurring          RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  document           Document?             @relation(fields: [documentId], references: [id], onDelete: SetNull)
  tagLinks           TransactionTagLink[]
  splits             TransactionSplit[]
  sourceTransfers    Transfer[]            @relation("SourceTransaction")
  destinationTransfers Transfer[]          @relation("DestinationTransaction")

  @@index([userId, date])
  @@index([accountId])
  @@index([creditCardBillId])
  @@map("transactions")
}

model TransactionTag {
  id        String   @id @default(uuid())
  name      String   @unique
  colorHex  String?  @map("color_hex")
  createdAt DateTime @default(now()) @map("created_at")

  links TransactionTagLink[]

  @@map("transaction_tags")
}

model TransactionTagLink {
  id            String @id @default(uuid())
  transactionId String @map("transaction_id")
  tagId         String @map("tag_id")

  transaction Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag         TransactionTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([transactionId, tagId])
  @@map("transaction_tag_links")
}

model TransactionSplit {
  id            String   @id @default(uuid())
  transactionId String   @map("transaction_id")
  categoryId    String   @map("category_id")
  amount        Decimal  @db.Decimal(14, 2)
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("transaction_splits")
}

model Transfer {
  id                       String   @id @default(uuid())
  sourceTransactionId      String   @unique @map("source_transaction_id")
  destinationTransactionId String   @unique @map("destination_transaction_id")
  isInternalHousehold      Boolean  @default(false) @map("is_internal_household")
  createdAt                DateTime @default(now()) @map("created_at")

  sourceTransaction      Transaction @relation("SourceTransaction", fields: [sourceTransactionId], references: [id], onDelete: Cascade)
  destinationTransaction Transaction @relation("DestinationTransaction", fields: [destinationTransactionId], references: [id], onDelete: Cascade)

  @@map("transfers")
}

model Installment {
  id             String   @id @default(uuid())
  description    String
  totalAmount    Decimal  @map("total_amount") @db.Decimal(14, 2)
  totalParts     Int      @map("total_parts")
  currentPart    Int      @map("current_part")
  amountPerPart  Decimal  @map("amount_per_part") @db.Decimal(14, 2)
  startDate      DateTime @map("start_date")
  createdAt      DateTime @default(now()) @map("created_at")

  transactions Transaction[]

  @@map("installments")
}

model RecurringTransaction {
  id          String          @id @default(uuid())
  name        String
  amount      Decimal         @db.Decimal(14, 2)
  type        TransactionType
  frequency   String          // 'MONTHLY', 'WEEKLY', 'ANNUAL'
  dayOfMonth  Int             @map("day_of_month")
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")

  transactions Transaction[]

  @@map("recurring_transactions")
}

// ------------------------------------------------------------------------------
// 5. ORÇAMENTOS, METAS E PLANEJAMENTO FINANCEIRO
// ------------------------------------------------------------------------------

model Budget {
  id          String   @id @default(uuid())
  householdId String   @map("household_id")
  categoryId  String   @map("category_id")
  amountLimit Decimal  @map("amount_limit") @db.Decimal(14, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  household Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  TransactionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  periods   BudgetPeriod[]

  @@unique([householdId, categoryId])
  @@map("budgets")
}

model BudgetPeriod {
  id            String   @id @default(uuid())
  budgetId      String   @map("budget_id")
  month         Int
  year          Int
  spentAmount   Decimal  @default(0.00) @map("spent_amount") @db.Decimal(14, 2)
  alertSentAt   DateTime? @map("alert_sent_at")

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, month, year])
  @@map("budget_periods")
}

model Goal {
  id                  String     @id @default(uuid())
  householdId         String     @map("household_id")
  title               String
  description         String?
  targetAmount        Decimal    @map("target_amount") @db.Decimal(14, 2)
  currentAmount       Decimal    @default(0.00) @map("current_amount") @db.Decimal(14, 2)
  targetDate          DateTime   @map("target_date")
  plannedMonthly      Decimal?   @map("planned_monthly") @db.Decimal(14, 2)
  status              GoalStatus @default(IN_PROGRESS)
  priority            Int        @default(1)
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  household     Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@map("goals")
}

model GoalContribution {
  id          String   @id @default(uuid())
  goalId      String   @map("goal_id")
  amount      Decimal  @db.Decimal(14, 2)
  date        DateTime @default(now())
  notes       String?

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@map("goal_contributions")
}

model FinancialPlan {
  id          String   @id @default(uuid())
  householdId String   @map("household_id")
  title       String
  description String?
  horizonMonths Int    @map("horizon_months")
  createdAt   DateTime @default(now()) @map("created_at")

  household Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  scenarios FinancialScenario[]

  @@map("financial_plans")
}

model FinancialScenario {
  id              String   @id @default(uuid())
  financialPlanId String   @map("financial_plan_id")
  name            String   // 'CONSERVATIVE', 'BASELINE', 'OPTIMISTIC'
  projectedRatePct Decimal @map("projected_rate_pct") @db.Decimal(5, 2)
  projectedSavings Decimal @map("projected_savings") @db.Decimal(14, 2)
  assumptionsJson  Json    @map("assumptions_json")

  financialPlan FinancialPlan @relation(fields: [financialPlanId], references: [id], onDelete: Cascade)

  @@map("financial_scenarios")
}

// ------------------------------------------------------------------------------
// 6. DOCUMENTOS, OCR E IMPORTAÇÕES
// ------------------------------------------------------------------------------

model Document {
  id           String       @id @default(uuid())
  userId       String       @map("user_id")
  storageKey   String       @map("storage_key")
  fileName     String       @map("file_name")
  fileSize     Int          @map("file_size")
  mimeType     String       @map("mime_type")
  type         DocumentType @default(OTHER)
  uploadedAt   DateTime     @default(now()) @map("uploaded_at")

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  extractions  DocumentExtraction[]
  transactions Transaction[]

  @@map("documents")
}

model DocumentExtraction {
  id          String   @id @default(uuid())
  documentId  String   @map("document_id")
  rawJson     Json     @map("raw_json")
  confidence  Decimal? @db.Decimal(5, 2)
  extractedAt DateTime @default(now()) @map("extracted_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_extractions")
}

model ImportBatch {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  fileName    String    @map("file_name")
  format      String    // 'OFX', 'CSV'
  totalRows   Int       @default(0) @map("total_rows")
  importedRows Int      @default(0) @map("imported_rows")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  rows ImportRow[]

  @@map("import_batches")
}

model ImportRow {
  id            String    @id @default(uuid())
  importBatchId String    @map("import_batch_id")
  rowIndex      Int       @map("row_index")
  rawData       Json      @map("raw_data")
  isDuplicate   Boolean   @default(false) @map("is_duplicate")
  isApproved    Boolean   @default(false) @map("is_approved")
  parsedDate    DateTime? @map("parsed_date")
  parsedAmount  Decimal?  @map("parsed_amount") @db.Decimal(14, 2)

  batch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@map("import_rows")
}

// ------------------------------------------------------------------------------
// 7. AGENTE FINANCEIRO (GEMINI), MENSAGENS E PREFERÊNCIAS
// ------------------------------------------------------------------------------

model AiConversation {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String   @default("Nova conversa")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  role           String   // 'user', 'model', 'system'
  content        String
  tokensUsed     Int?     @map("tokens_used")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolCalls    AiToolCall[]

  @@map("ai_messages")
}

model AiToolCall {
  id          String   @id @default(uuid())
  messageId   String   @map("message_id")
  toolName    String   @map("tool_name")
  argsJson    Json     @map("args_json")
  resultJson  Json?    @map("result_json")
  status      String   @default("EXECUTED") // 'EXECUTED', 'REQUIRES_CONFIRMATION', 'REJECTED'
  executedAt  DateTime @default(now()) @map("executed_at")

  message AiMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("ai_tool_calls")
}

model AiPreference {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  key         String
  valueJson   Json     @map("value_json")
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("ai_preferences")
}

// ------------------------------------------------------------------------------
// 8. NOTIFICAÇÕES, AUDITORIA, LGPD E CONFIGURAÇÕES
// ------------------------------------------------------------------------------

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  message   String
  type      String   // 'ALERT', 'SYNC', 'GOAL', 'BUDGET'
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model UserConsent {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  termVersion String   @map("term_version")
  consentType String   @map("consent_type") // 'TERMS_OF_USE', 'PRIVACY_POLICY', 'OPEN_FINANCE'
  hasGranted  Boolean  @default(true) @map("has_granted")
  grantedAt   DateTime @default(now()) @map("granted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_consents")
}

model AppSetting {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  key         String   @unique
  valueJson   Json     @map("value_json")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("app_settings")
}

