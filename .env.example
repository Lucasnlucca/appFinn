# ==============================================================================
# FINN AI — Environment Variables Template
# All secrets must be provided in .env (never commit .env to version control)
# ==============================================================================

# Application Environment
NODE_ENV=development
APP_NAME=FINN AI
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000
WEB_PORT=3000

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://finn_user:finn_password@localhost:5432/finn_ai?schema=public

# Cache & Background Workers (Redis)
REDIS_URL=redis://localhost:6379

# Security & Encryption
# SESSION_SECRET must be at least 32 characters random string
SESSION_SECRET=change-me-to-a-very-secure-random-32-chars-key
# ENCRYPTION_KEY must be a 32-byte hexadecimal string for AES-256-GCM bank token encryption
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_ACCESS_SECRET=change-me-to-a-jwt-access-secret-minimum-32-characters
JWT_REFRESH_SECRET=change-me-to-a-jwt-refresh-secret-minimum-32-characters
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Google Gemini API
# SDK: @google/genai
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_MAX_TOKENS_PER_DAY=100000

# Open Finance — Pluggy (Meu Pluggy Personal Mode)
# Free tier: max 5 connections, sync approx every 24h
PLUGGY_CLIENT_ID=your_pluggy_client_id_here
PLUGGY_CLIENT_SECRET=your_pluggy_client_secret_here
PLUGGY_BASE_URL=https://api.pluggy.ai
PLUGGY_MODE=personal

# Private Object Storage (S3-compatible, e.g. MinIO / Hostinger S3 / Cloudflare R2)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=finn-ai-documents
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Email Notification / Household Invitations (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=FINN AI <no-reply@finn-ai.local>

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

