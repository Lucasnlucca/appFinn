{
  "expo": {
    "name": "FINN AI",
    "slug": "finn-ai",
    "scheme": "finnai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#7C3AED",
    "backgroundColor": "#F8FAFC",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#7C3AED"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.finnai.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "FINN precisa do microfone para gravar áudios e conversar por voz com seu assistente financeiro de IA.",
        "NSPhotoLibraryUsageDescription": "FINN precisa acessar suas fotos para você escolher sua imagem de perfil.",
        "NSCameraUsageDescription": "FINN precisa da câmera para você tirar sua foto de perfil."
      }
    },
    "android": {
      "package": "com.finnai.app",
      "versionCode": 1,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VISUAL_USER_SELECTED",
        "READ_EXTERNAL_STORAGE",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      "expo-video",
      "expo-font",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "largeIcon": "./assets/splash-icon.png",
          "color": "#7C3AED",
          "defaultChannel": "finn-smart-alerts"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FINN precisa acessar suas fotos para você escolher sua imagem de perfil.",
          "cameraPermission": "FINN precisa da câmera para você tirar sua foto de perfil."
        }
      ],
      "expo-document-picker",
      "@react-native-google-signin/google-signin"
    ]
  }
}
