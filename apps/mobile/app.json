{
  "expo": {
    "name": "FINN AI",
    "slug": "finn-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "primaryColor": "#10B981",
    "backgroundColor": "#0B0F19",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "FINN precisa do microfone para gravar áudios estilo WhatsApp e conversar por voz com a IA financeira."
      }
    },
    "android": {
      "package": "com.finnai.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F19",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      "expo-video",
      "expo-font"
    ]
  }
}
